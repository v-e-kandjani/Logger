# ==============================================================================
# Valtrivo LogSeal - Production Environment Configuration
# Tagline: "Her kayıt, zamanıyla kanıt."
# ==============================================================================

# Web Dashboard & REST API Port on Host
APP_PORT=8080
SERVER_LISTEN_ADDR=0.0.0.0:8080

# PostgreSQL Configuration
# Note: Host ports are bound strictly to 127.0.0.1 (local only)
POSTGRES_DB=syslog_manager
POSTGRES_USER=syslog_admin
POSTGRES_PASSWORD=syslog_secret
POSTGRES_LOCAL_PORT=5432
POSTGRES_SSLMODE=disable

# ClickHouse Analytical Store Configuration
# Note: Host ports are bound strictly to 127.0.0.1 (local only)
CLICKHOUSE_DATABASE=syslog
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_LOCAL_PORT=9000
CLICKHOUSE_HTTP_LOCAL_PORT=8123

# Initial Super Administrator Account
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=admin5651!

# Timestamp Provider (internal, kamusm, mock)
TIMESTAMP_PROVIDER=mock
ARCHIVE_PATH=/opt/syslog-platform/archive
